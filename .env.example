# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
# GUILD_ID=your_guild_id_here (optional — restricts slash commands to one guild for testing)

# Owner Configuration (comma-separated list of user IDs)
OWNER_IDS=123456789012345678

# Bot Settings
PREFIX=c!
NODE_ENV=development

# API Settings
API_PORT=4000
API_PREFIX=api

# Database Configuration (PostgreSQL)
# docker-compose maps PostgreSQL to host port 5433
DATABASE_URL= # postgresql://admin:secure_password@localhost:5433/your_database_name_here

# Credentials used by docker-compose to provision the PostgreSQL container
POSTGRES_USER=admin
POSTGRES_PASSWORD=secure_password
POSTGRES_DB=caramel

# Redis Configuration
# docker-compose maps Redis to host port 6380
REDIS_URL= # redis://localhost:6380

# Image Proxy Configuration (Local Weserv)
IMAGE_PROXY_URL= # http://localhost:1234

# Deploy metadata (set automatically by deploy script)
DEPLOY_VERSION=dev
